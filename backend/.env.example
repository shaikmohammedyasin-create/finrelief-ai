# --- App ---
APP_NAME=FinRelief AI
ENVIRONMENT=development
DEBUG=true

# --- Security / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Local dev (SQLite):
DATABASE_URL=sqlite:///./finrelief.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/finrelief

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
